items-center px-2 py-2 rounded-r-md border border-gray-300 bg-white text-sm font-medium text-gray-500 hover:bg-gray-50 disabled:opacity-50\"\n                  >\n                    Next\n                  </button>\n                </nav>\n              </div>\n            </div>\n          </div>\n        )}\n      </div>\n\n      {students.length === 0 && (\n        <div className=\"text-center py-12\">\n          <svg className=\"mx-auto h-12 w-12 text-gray-400\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n            <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z\" />\n          </svg>\n          <h3 className=\"mt-2 text-sm font-medium text-gray-900\">No students found</h3>\n          <p className=\"mt-1 text-sm text-gray-500\">Try adjusting your filters or add some students.</p>\n        </div>\n      )}\n    </div>\n  );\n}","usedDeprecatedRules":[]},{"filePath":"/Users/navneetshreya/buddhi_archives/client/src/app/(dashboard)/admin_subadmin/students/page.js","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/navneetshreya/buddhi_archives/client/src/app/(dashboard)/faculty/add-notice/page.js","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/navneetshreya/buddhi_archives/client/src/app/(dashboard)/faculty/attendance/_components/AttendanceBar.js","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/navneetshreya/buddhi_archives/client/src/app/(dashboard)/faculty/attendance/_components/AttendanceHeader.js","messages":[{"ruleId":"react-hooks/set-state-in-effect","severity":2,"message":"Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\n  24 |   const [selectedYear, setSelectedYear] = useState(new Date().getFullYear());\n  25 |\n> 26 |   useEffect(() => setLocal(classInfo), [classInfo]);\n     |                   ^^^^^^^^ Avoid calling setState() directly within an effect\n  27 |\n  28 |   const onChange = (k, v) => {\n  29 |     setLocal(prev => ({ ...prev, [k]: v }));","line":26,"column":19,"nodeType":null,"endLine":26,"endColumn":27}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"\"use client\";\n\nimport { useEffect, useState } from \"react\";\n\nconst MONTHS = [\n  \"January\", \"February\", \"March\", \"April\", \"May\", \"June\",\n  \"July\", \"August\", \"September\", \"October\", \"November\", \"December\"\n];\n\nexport default function AttendanceHeader({ \n  classInfo, \n  setClassInfo, \n  mode, \n  setMode, \n  view, \n  setView, \n  assignedCourses = [], \n  onCourseChange,\n  onMonthYearChange \n}) {\n  const [local, setLocal] = useState(classInfo);\n  const [showMonthlyOption, setShowMonthlyOption] = useState(false);\n  const [selectedMonth, setSelectedMonth] = useState(new Date().getMonth() + 1);\n  const [selectedYear, setSelectedYear] = useState(new Date().getFullYear());\n\n  useEffect(() => setLocal(classInfo), [classInfo]);\n\n  const onChange = (k, v) => {\n    setLocal(prev => ({ ...prev, [k]: v }));\n    setClassInfo(prev => ({ ...prev, [k]: v }));\n  };\n\n  const handleLoadMonthly = () => {\n    if (local.courseId && selectedMonth && selectedYear) {\n      onMonthYearChange?.(selectedMonth, selectedYear);\n    }\n  };\n\n  return (\n    <div className=\"bg-white p-4 rounded-lg shadow flex flex-col gap-3\">\n      <div className=\"flex gap-3 items-center\">\n        {assignedCourses.length > 0 ? (\n          <>\n            <select \n              value={local.courseId || \"\"} \n              onChange={e => onCourseChange?.(e.target.value)} \n              className=\"border p-2 rounded flex-1\"\n              required\n            >\n              <option value=\"\">Select Assigned Course</option>\n              {assignedCourses.map(ac => (\n                <option key={ac._id} value={ac.course._id}>\n                  {ac.course.code} - {ac.course.name} (Sem {ac.semester}, Sec {ac.section || 'All'}, Batch {ac.batch || 'All'})\n                </option>\n              ))}\n            </select>\n            <div className=\"text-sm text-gray-600 whitespace-nowrap\">\n              Sem: {local.semester || '-'} | Sec: {local.section || 'All'} | Batch: {local.batch || 'All'}\n            </div>\n          </>\n        ) : (\n          <div className=\"flex-1 text-center text-gray-500 py-2\">\n            No courses assigned. Please contact admin to assign courses.\n          </div>\n        )}\n        \n        {!showMonthlyOption ? (\n          <>\n            <input type=\"date\" value={local.date} onChange={e=>onChange(\"date\", e.target.value)} className=\"border p-2 rounded\" />\n            <input value={local.period} onChange={e=>onChange(\"period\", e.target.value)} placeholder=\"Period\" className=\"w-20 border p-2 rounded\" />\n          </>\n        ) : (\n          <>\n            <select \n              value={selectedMonth} \n              onChange={e => setSelectedMonth(parseInt(e.target.value))}\n              className=\"border p-2 rounded\"\n            >\n              {MONTHS.map((month, idx) => (\n                <option key={idx} value={idx + 1}>{month}</option>\n              ))}\n            </select>\n            <select \n              value={selectedYear} \n              onChange={e => setSelectedYear(parseInt(e.target.value))}\n              className=\"border p-2 rounded\"\n            >\n              {Array.from({ length: 5 }, (_, i) => new Date().getFullYear() - 2 + i).map(year => (\n                <option key={year} value={year}>{year}</option>\n              ))}\n            </select>\n            <button\n              onClick={handleLoadMonthly}\n              disabled={!local.courseId}\n              className=\"px-4 py-2 bg-blue-500 text-white rounded hover:bg-blue-600 disabled:bg-gray-300 whitespace-nowrap\"\n            >\n              Load Monthly\n            </button>\n          </>\n        )}\n      </div>\n\n      <div className=\"flex items-center justify-between\">\n        <div className=\"flex items-center gap-3\">\n          <div className=\"flex items-center gap-1\">\n            <label className=\"text-sm\">Type</label>\n            <select \n              value={showMonthlyOption ? \"monthly\" : \"daily\"} \n              onChange={e => setShowMonthlyOption(e.target.value === \"monthly\")} \n              className=\"border p-2 rounded ml-2\"\n            >\n              <option value=\"daily\">Daily Attendance</option>\n              <option value=\"monthly\">Monthly Attendance</option>\n            </select>\n          </div>\n\n          {!showMonthlyOption && (\n            <>\n              <div className=\"flex items-center gap-1\">\n                <label className=\"text-sm\">Mode</label>\n                <select value={local.mode} onChange={e => { onChange(\"mode\", e.target.value); setMode?.(e.target.value); }} className=\"border p-2 rounded ml-2\">\n                  <option value=\"theory\">Theory</option>\n                  <option value=\"lab\">Lab</option>\n                </select>\n              </div>\n\n              <div className=\"flex items-center gap-1\">\n                <label className=\"text-sm\">View</label>\n                <select value={view} onChange={e => setView?.(e.target.value)} className=\"border p-2 rounded ml-2\" disabled={!local.courseId}>\n                  <option value=\"manual\">Manual</option>\n                  <option value=\"excel\">Excel Upload</option>\n                </select>\n              </div>\n            </>\n          )}\n        </div>\n\n        <div className=\"text-sm text-gray-500\">\n          {assignedCourses.length > 0 ? `${assignedCourses.length} course(s) assigned` : \"No courses assigned\"}\n        </div>\n      </div>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/navneetshreya/buddhi_archives/client/src/app/(dashboard)/faculty/attendance/_components/AttendanceHistoryTable.js","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/navneetshreya/buddhi_archives/client/src/app/(dashboard)/faculty/attendance/_components/BulkActions.js","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/navneetshreya/buddhi_archives/client/src/app/(dashboard)/faculty/attendance/_components/EditBulkModal.js","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/navn